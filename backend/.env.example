# Konfigurasi Server Backend
PORT=3000

# Konfigurasi Database MySQL
# Untuk lokal: DB_HOST=localhost, DB_USER=root, DB_PASSWORD=, DB_NAME=db_react_ninetasy, DB_PORT=3306
# Untuk deploy cloud (Railway / Aiven / TiDB / cPanel): sesuaikan dengan info dari provider
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_react_ninetasy
DB_PORT=3306

# Atur ke 'true' jika cloud database mewajibkan SSL (misal: Aiven MySQL atau TiDB)
DB_SSL=false

# Opsional: URL Frontend untuk proteksi CORS (kosongkan atau isi URL frontend saat dideploy, misal https://ninetasy.vercel.app)
CLIENT_URL=
